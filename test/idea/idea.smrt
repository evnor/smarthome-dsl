{
  components: [
    ParkingController: {
      [
        port(FROM_BARRIER, CarEvent),
        port(TO_SIGNAL, SignalEvent),
      ],
      {
        states: [Full(int total), Available(int total, int available)],
        initial: Full(10),
        transition(
          Full -> Available,
          (FROM_BARRIER, CarEvent.CAR_OUT)
          action: state => {
            send(TO_SIGNAL, SignalEvent.LED_GREEN, delay = 1000);
            Available(state.total, 1)
          }
        ),
        transition(
          Available -> Full,
          (FROM_BARRIER, CarEvent.CAR_IN)
          condition: state => state.available == 1,
          action: state => {
            send(TO_SIGNAL, SignalEvent.LED_RED);
            Full(state.total)
          }
        ),
        transition(
          Available -> Available,
          (FROM_BARRIER, CarEvent.CAR_IN)
          action: state => Available(state.total, state.available - 1)
        ),
        transition(
          Available -> Available,
          (FROM_BARRIER, CarEvent.CAR_OUT)
          action: state => Available(state.total, min(state.available + 1, state.total))
        ),
      }
    }
  ],
  connections: [
    {
      source(ParkingController, TO_SIGNAL)
      target(http_json("/signal"))
      // TODO specify ChannelType, TYPE
    },
    {
      source(http_json("/barrier"))
      target(ParkingController, FROM_BARRIER)
      // TODO specify ChannelType, TYPE
      // Do we specify ChannelType, or just try to accept anything?
    },
  ],
  types: [
    CarEvent: enum{
      CAR_IN = 0,
      CAR_OUT = 1,
    },
    SignalEvent<int>: enum{
      LED_RED,
      LED_GREEN,
    },
  ]
}